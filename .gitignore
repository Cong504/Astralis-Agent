# Python 运行环境
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 模型权重（体积大，放 NAS，不入库）
models/
*.safetensors
*.bin
*.gguf

# Docker 构建缓存与本地构建产物
build/
.docker-cache/

# 运行时数据库（append-only 审计源为 logs/*.jsonl，均不入库）
*.db
*.sqlite
*.sqlite3
logs/*.jsonl

# Agent 包导出产物（由 scripts/export_sample_package.py 可复现，不入库二进制）
*.agentpkg

# 凭据：密钥只存环境变量，绝不入库（SANDBOX_RULES.md §6 / PACKAGE_SPEC.md §7）
.env
*.key
*.pem

# 编辑器与系统文件
.vscode/
.idea/
Thumbs.db
