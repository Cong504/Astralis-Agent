{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local-agent.local/schema/plan.schema.json",
  "title": "ExecutionPlan",
  "description": "模型输出的结构化执行计划。字段与 PACKAGE_SPEC.md §5 技能定义对齐；risk_level 枚举与包规范一致。",
  "type": "object",
  "required": ["task_id", "goal", "steps"],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "description": "任务唯一标识，由 Interface 层生成并透传给模型",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "description": "任务目标的自然语言复述",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "description": "可执行步骤列表，W1 不真跑，仅打印执行意图",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["step_id", "action", "tool", "args", "risk_level"],
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string",
          "description": "步骤序号，格式 step-<n>",
          "pattern": "^step-[0-9]+$"
        },
        "action": {
          "type": "string",
          "description": "该步骤要做什么，自然语言描述",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "description": "要调用的工具名（W1 为桩，工具白名单见 W2 的 5 个基础工具）",
          "enum": ["dir_scan", "file_read", "script_run", "report_write", "log_record"]
        },
        "args": {
          "type": "object",
          "description": "工具参数，键名与具体工具定义一致",
          "additionalProperties": true
        },
        "risk_level": {
          "type": "string",
          "description": "风险等级，与 PACKAGE_SPEC.md §5 一致",
          "enum": ["low", "medium", "high"]
        },
        "requires_confirm": {
          "type": "boolean",
          "description": "是否需要用户二次确认；high 风险必须为 true（对齐 PACKAGE_SPEC.md §5）",
          "default": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "risk_level": { "const": "high" } }, "required": ["risk_level"] },
          "then": { "properties": { "requires_confirm": { "const": true } }, "required": ["requires_confirm"] }
        }
      ]
    }
  }
}
